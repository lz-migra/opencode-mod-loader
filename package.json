{
  "name": "opencode-mod-loader",
  "version": "1.0.0",
  "description": "Reverse proxy + dynamic mod loader for OpenCode Web (v1.18.4 compatible)",
  "type": "module",
  "private": true,
  "main": "server.mjs",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "list-mods": "node scripts/list-mods.mjs",
    "validate-mods": "node scripts/validate-mods.mjs",
    "launcher": "bun launcher.mjs",
    "launcher:dev": "bun --watch launcher.mjs"
  },
  "dependencies": {
    "@opentui/core": "^0.4.5",
    "chokidar": "^3.6.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "jsdom": "^29.1.1"
  }
}
